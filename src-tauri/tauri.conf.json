{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LEAD",
  "version": "1.0.0",
  "identifier": "com.nen.lead",
  "build": {
    "beforeDevCommand": "npm run dev -- -p 3003",
    "devUrl": "http://localhost:3003",
    "beforeBuildCommand": "",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "LEAD",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 700,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
